{
  "expo": {
    "name": "Dala",
    "slug": "hazemzammit",
    "scheme": "dala",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAFA"
    },
    "assetBundlePatterns": ["**/*"],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/97011893-3003-4c19-89df-699323ebea9b"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "tn.dala.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Dala utilise Face ID pour verrouiller l'application sur cet appareil, si vous activez cette option dans Sécurité."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFAFA"
      },
      "package": "tn.dala.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@sentry/react-native",
      [
        "expo-image-picker",
        {
          "photosPermission": "Dala a besoin d'accéder à vos photos pour joindre une image à une mise à jour de chantier.",
          "cameraPermission": "Dala a besoin d'accéder à l'appareil photo pour documenter l'avancement du chantier."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Dala a besoin du micro pour enregistrer une note vocale sur une mise à jour de chantier."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Dala peut associer un repère de localisation à une photo de chantier, uniquement avec votre autorisation."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "pickFirst": ["**/libc++_shared.so"]
            },
            "usesCleartextTraffic": true
          }
        }
      ],
      "@morrowdigital/watermelondb-expo-plugin",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "97011893-3003-4c19-89df-699323ebea9b"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "hazemzammits-team"
  }
}
