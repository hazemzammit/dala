{
  "expo": {
    "name": "Dala",
    "slug": "hazemzammit",
    "scheme": "dala",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAFA"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "tn.dala.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFAFA"
      },
      "package": "tn.dala.app"
    },
    "plugins": ["expo-router", "expo-secure-store", "@sentry/react-native"],
    "extra": {
      "eas": {
        "projectId": "97011893-3003-4c19-89df-699323ebea9b"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "hazemzammits-team"
  }
}
