# =============================================================================
# Dala — environment variables reference
# =============================================================================
# This file is committed. Copy it to .env (root, ignored by git) AND to the
# app-specific locations below, then fill in real values from:
#   - Supabase dashboard > Project Settings > API
#   - Resend dashboard > API Keys
#   - PostHog dashboard > Project Settings
#   - Sentry dashboard > Project Settings > Client Keys (DSN)
#   - Konnect merchant dashboard
#
# NEVER commit a filled-in .env file. NEVER paste real keys into chat, Slack,
# or a GitHub issue. If a key leaks, rotate it immediately in the provider's
# dashboard.
#
# Where each variable is actually consumed:
#   apps/web/.env.local        -> NEXT_PUBLIC_* and web-only vars
#   apps/admin/.env.local      -> NEXT_PUBLIC_* and admin-only vars
#   apps/mobile/.env           -> EXPO_PUBLIC_* vars
#   supabase/.env (local CLI)  -> SUPABASE_* service vars (never shipped to a client)
# =============================================================================

# --- Supabase (shared backend, one project per environment) ---
# Public: safe to expose to a browser/mobile bundle. Anon key is subject to RLS.
# --- Supabase (Local Development) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Secret: server-side only (Edge Functions, CI scripts, seed scripts).
# NEVER prefix with NEXT_PUBLIC_ / EXPO_PUBLIC_. NEVER bundle into a client app.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz
SUPABASE_PROJECT_REF=

# --- Auth / email ---
# Format: re_<...>. Get yours from the Resend dashboard; NEVER paste a real key here.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Analytics ---
# NOTE: PostHog is NOT wired into any app yet (no code reads these; posthog-js /
# posthog-react-native are installed but never imported). Kept so the names are reserved.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
EXPO_PUBLIC_POSTHOG_KEY=

# --- Error tracking (separate DSN per client, per Doc 01 §1.1) ---
# These are the names the code actually reads. (This file used to define SENTRY_DSN_WEB /
# SENTRY_DSN_ADMIN / SENTRY_DSN_MOBILE, which nothing reads — following it left Sentry
# silently disabled in every app.) web + admin share NEXT_PUBLIC_SENTRY_DSN's name but are
# separate deployments, so give each deployment its own project's DSN.
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=

# --- Mobile: Google Static Maps (embedded in the app bundle; restrict it by bundle id in GCP) ---
EXPO_PUBLIC_GOOGLE_STATIC_MAPS_KEY=

# --- Payments ---
# Edge Functions (supabase secrets set ...). PAYMENT_PROVIDER: stripe_test (default) | konnect.
PAYMENT_PROVIDER=stripe_test
STRIPE_SECRET_KEY=
# Signing secret of the payment-webhook endpoint. Its signature is VERIFIED (HMAC-SHA256,
# 5-minute replay window) — an unset secret makes the webhook refuse everything.
STRIPE_WEBHOOK_SECRET=
# Konnect is not implemented yet (the provider branch throws); reserved names only.
KONNECT_API_KEY=
KONNECT_WALLET_ID=
KONNECT_ENV=sandbox

# --- Edge Functions ---
# Public origin used in e-mail links.
APP_URL=http://localhost:3000
# Resend (e-mail events) webhook signing secret, format whsec_<base64>.
RESEND_WEBHOOK_SECRET=
# Optional: cron/internal functions accept the service-role key; set this to authenticate
# them with a different shared secret instead (see _shared/internalAuth.ts).
INTERNAL_FUNCTION_SECRET=
# Number of trusted proxies in front of the Edge Functions, for rate-limit client-IP lookup
# (counted from the right of X-Forwarded-For; default 1). cf-connecting-ip is preferred.
TRUSTED_PROXY_HOPS=1
# Optional alert sink for admin health checks.
ADMIN_ALERT_WEBHOOK_URL=

# --- Admin app (apps/admin) ---
# Direct Postgres connection (Database Explorer danger zone, TOTP key rotation).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# HS256 key for the admin session cookie (>= 32 random bytes). Generate: openssl rand -hex 32
ADMIN_SESSION_SECRET=
# Comma-separated egress IPs allowed to reach the admin console. EMPTY = gate OFF (dev only);
# REQUIRED in production.
ADMIN_IP_ALLOWLIST=

# --- App metadata ---
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# --- CI-only (GitHub Actions secrets, not needed for local dev) ---
# SUPABASE_ACCESS_TOKEN=      (used by `supabase db push` in CI)

# --- Admin login hardening (apps/admin) — leave UNSET in production ---
# Defaults: 10 password attempts / email and 5 TOTP attempts / admin per 15 min,
# TOTP replay guard always on. For local e2e runs (many logins as the same admin)
# you may relax them; they are ignored/clamped when NODE_ENV=production.
# ADMIN_PASSWORD_MAX_ATTEMPTS=100000
# ADMIN_TOTP_MAX_ATTEMPTS=100000
# ADMIN_TOTP_REPLAY_GUARD=off

# --- Admin IP allowlist behind proxies (apps/admin) ---
# X-Forwarded-For is client-controlled on its LEFT. The admin app reads the client IP
# counting from the RIGHT: number of trusted proxies in front of it (default 1 — e.g.
# Vercel, or a single load balancer). Use 2 for CDN -> load balancer, etc.
# ADMIN_TRUSTED_PROXY_HOPS=1
# ADMIN_IP_ALLOWLIST is REQUIRED in production (comma-separated egress IPs); empty = gate off.

# --- Admin Database Explorer read path (apps/admin) — REQUIRED in production ---
# Least-privilege role created by migration 0104 (read-only; no vault/auth/credential tables).
# Set its password once:  alter role admin_explorer_login with password '<long random>';
# DATABASE_URL_EXPLORER_RO=postgresql://admin_explorer_login:<password>@<host>:5432/postgres
